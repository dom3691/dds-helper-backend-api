{
  "ConnectionStrings": {
    "DispatchDBEntities": "Server=localhost;Database=DispatchDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "LogDirectory": "C:\\DDS_Logs",
    "Using": [
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "C:\\DDS_Logs\\dds-helper-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} | {Level:u3} | Trace:{TraceId} | {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "Cors": {
    "AllowedOrigins": [
      "http://127.0.0.1:4200",
      "http://localhost:4200"
    ],
    "AllowCredentials": false
  },
  "AllowedHosts": "*"
}
